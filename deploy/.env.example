# Ahmed Multi-Tenant Hosting Platform — Production Environment Template
# Copy to /etc/ahmed-hosting/platform.env (chmod 600) and fill strong random values.

# Bind privately on loopback so ONLY Cloudflare Tunnel can reach the origin
HOST=127.0.0.1
PORT=8787

# Persistent storage root for master.sqlite, master.key, tenant SQLite DBs, media, and backups
DATA_DIR=/var/lib/ahmed-hosting/data

# Dedicated Master Hosting Panel hostname (protect behind Cloudflare Access / Zero Trust)
MASTER_PANEL_HOST=panel.example.com

# Master encryption key (at least 32 random bytes, e.g. `openssl rand -hex 32`)
PLATFORM_MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Shared HMAC secret between cloudflare-proxy-worker and this Node.js origin (`openssl rand -hex 32`)
ORIGIN_HMAC_SECRET=CHANGE_ME_SAME_SECRET_AS_WRANGLER_SECRET

# Enforce authenticated origin headers in production (MUST be 0 in production!)
ALLOW_UNAUTHENTICATED_ORIGIN=0
TRUST_PROXY=1
