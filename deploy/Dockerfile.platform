FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci
COPY src ./src
COPY scripts ./scripts
COPY cloudflare-proxy-worker ./cloudflare-proxy-worker
RUN npm run typecheck && npm run build:platform

FROM node:22-alpine
WORKDIR /app
RUN addgroup -S ahmedhost && adduser -S -G ahmedhost ahmedhost \
  && mkdir -p /data && chown -R ahmedhost:ahmedhost /data
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8787 \
    DATA_DIR=/data \
    TRUST_PROXY=1
EXPOSE 8787
VOLUME ["/data"]
USER ahmedhost
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 8787) + '/internal/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "--disable-warning=ExperimentalWarning", "dist/platform.mjs"]
