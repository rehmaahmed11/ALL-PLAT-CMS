# Example cloudflared Tunnel configuration for Phase 12 Production Cutover.
# Replace <TUNNEL-UUID> and hostnames with your real Cloudflare Tunnel & domain values.
# Never expose port 8787 publicly on the VPS firewall.

tunnel: <TUNNEL-UUID>
credentials-file: /etc/cloudflared/<TUNNEL-UUID>.json

ingress:
  # 1. Master Hosting Panel (also protect this hostname with Cloudflare Zero Trust Access)
  - hostname: panel.example.com
    service: http://127.0.0.1:8787

  # 2. Private Origin used by cloudflare-proxy-worker (ORIGIN_URL) for all customer domains
  - hostname: origin.example.com
    service: http://127.0.0.1:8787

  - service: http_status:404
