{
  "name": "ams-cloud-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AMS Cloud Panel — a multi-site hosting control panel that runs on Cloudflare Free Workers (D1 + KV + R2-free file store) and on a local Node.js preview.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy": "node scripts/adopt-resources.mjs --provision",
    "cloudflare:adopt": "node scripts/adopt-resources.mjs",
    "local": "node local/server.mjs",
    "build": "node scripts/bundle.mjs",
    "cms:template:build": "node scripts/build-cms-template.mjs",
    "cms:template:upload": "node scripts/upload-cms-template.mjs",
    "cms:template:refresh": "node scripts/refresh-cms-template.mjs",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "test:vps": "node --test tests/vps-http.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
